/* Shared style for all UI Toolkit screens. Edit colors here only. */

/* ---- Palette (change these to restyle everything) ---- */
/* bg          #14161c   panel #1e2029   accent #d9822b
   text        #e8e6e3   muted #9a9a9a */

/* Full-screen root of every screen. UIController toggles .screen--hidden. */
.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 22, 28, 0.94);
}

.screen--hidden {
    display: none;
}

/* Centered card holding the buttons */
.panel {
    width: 380px;
    padding: 28px;
    background-color: rgb(30, 32, 41);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(52, 55, 68);
    align-items: stretch;
}

.title {
    font-size: 40px;
    color: rgb(232, 230, 227);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
    white-space: normal;
}

.subtitle {
    font-size: 24px;
    color: rgb(232, 230, 227);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

/* ---- Buttons ---- */
.btn {
    height: 46px;
    margin: 6px 0;
    padding: 0;
    font-size: 18px;
    color: rgb(232, 230, 227);
    background-color: rgb(44, 47, 60);
    border-width: 0;
    border-radius: 10px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: rgb(217, 130, 43);
    color: rgb(20, 22, 28);
    scale: 1.03 1.03;
}

.btn:active {
    background-color: rgb(180, 105, 30);
    scale: 0.98 0.98;
}

/* Dimmed rather than removed: SetEnabled(false) also blocks picking, so :hover never
   fires on a disabled button and it cannot be clicked. */
.btn:disabled {
    opacity: 0.35;
}

.btn--danger:hover {
    background-color: rgb(190, 60, 60);
    color: rgb(240, 240, 240);
}

/* ---- Settings rows ---- */
.row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 10px 0;
}

.row__label {
    font-size: 16px;
    color: rgb(232, 230, 227);
}

/* Slider / Toggle inherit Unity default theme; only sizing + text color here */
.setting-slider {
    width: 190px;
    margin: 0;
}

.setting-slider .unity-base-slider__tracker {
    background-color: rgb(60, 63, 78);
}

.setting-slider .unity-base-slider__dragger {
    background-color: rgb(217, 130, 43);
    border-width: 0;
    border-radius: 8px;
}

.setting-toggle {
    margin: 0;
}

.value-label {
    font-size: 14px;
    color: rgb(154, 154, 154);
    width: 46px;
    -unity-text-align: middle-right;
}

/* ================= Stats screen ================= */

.panel--wide {
    width: 760px;
    padding: 22px;
}

/* ---- Header ---- */
.stats-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.stats-header__title {
    font-size: 28px;
    color: rgb(232, 230, 227);
    -unity-font-style: bold;
    flex-grow: 1;
}

.stats-points {
    font-size: 16px;
    color: rgb(217, 130, 43);
    -unity-font-style: bold;
    margin-right: 12px;
}

.btn--icon {
    width: 34px;
    height: 34px;
    margin: 0;
    font-size: 16px;
}

/* ---- Two-column body ---- */
.stats-body {
    flex-direction: row;
    justify-content: space-between;
}

.stats-column {
    width: 48%;
}

.stats-column__title {
    font-size: 18px;
    color: rgb(154, 154, 154);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.stats-list {
    height: 300px;
    background-color: rgb(24, 26, 33);
    border-radius: 10px;
    padding: 6px;
}

/* ---- One stat row ---- */
.stat-row {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 6px;
    margin-bottom: 4px;
    border-radius: 8px;
    background-color: rgb(34, 37, 47);
}

.stat-row__name {
    flex-grow: 1;
    font-size: 15px;
    color: rgb(232, 230, 227);
}

.stat-row__value {
    width: 56px;
    font-size: 15px;
    color: rgb(232, 230, 227);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.stat-row__bonus {
    width: 62px;
    font-size: 13px;
    color: rgb(154, 154, 154);
    -unity-text-align: middle-right;
}

.stat-row__step {
    width: 26px;
    height: 26px;
    margin: 0 0 0 6px;
    padding: 0;
    font-size: 16px;
    border-radius: 6px;
}

/* ---- Footer ---- */
.stats-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
}

.btn--footer {
    width: 130px;
    height: 40px;
    margin: 0 0 0 8px;
    font-size: 16px;
}

/* ---- Floating open button (no dim, click-through elsewhere) ---- */
.open-bar {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0);
}

.btn--open {
    width: 140px;
    height: 42px;
    margin: 0;
    font-size: 16px;
}
