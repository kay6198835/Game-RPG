<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- Shared stylesheet. Relative path avoids URI escaping. -->
    <Style src="../Styles/GameUI.uss" />

    <ui:VisualElement name="main-menu" class="screen">
        <ui:VisualElement class="panel">
            <ui:Label text="GAME RPG" class="title" />
            <ui:Button name="btn-play"     text="Play"     class="btn" />
            <ui:Button name="btn-settings" text="Settings" class="btn" />
            <ui:Button name="btn-quit"     text="Quit"     class="btn btn--danger" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
