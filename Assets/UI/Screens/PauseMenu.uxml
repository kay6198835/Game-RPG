<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="../Styles/GameUI.uss" />

    <ui:VisualElement name="pause-menu" class="screen">
        <ui:VisualElement class="panel">
            <ui:Label text="PAUSED" class="subtitle" />
            <ui:Button name="btn-resume"    text="Resume"    class="btn" />
            <ui:Button name="btn-settings"  text="Settings"  class="btn" />
            <ui:Button name="btn-mainmenu"  text="Main Menu" class="btn btn--danger" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
