#!/usr/bin/env bash
# pre-push — process gate decided in S21-09 (C + B). Install once per clone:
#   git config core.hooksPath .githooks
#
# Owner decision 2026-11-04: the gate blocks pushes to `main` ONLY.
#   main          C + B run; any ERROR or compile failure blocks the push.
#   other branch  C runs as a warning only (seconds, never blocks); B is skipped.
#
# C  static-check.sh — no Unity, seconds. Flags removed/renamed serialized fields still stored in assets.
# B  compile-check.sh — headless Unity compile of this checkout. Runs only when no Unity Editor is
#    open (the Editor holds the project lock). Skip it with GATE_SKIP_COMPILE=1.
#
# Escape hatch for an emergency: git push --no-verify (record why in the sprint file).
set -u
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
fail=0
strict=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  ref_strict=0
  case "$remote_ref" in refs/heads/main) ref_strict=1; strict=1 ;; esac

  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    oldest=$(git rev-list "$local_sha" --not --remotes | tail -1)
    [ -z "$oldest" ] && continue
    base=$(git rev-parse -q --verify "$oldest^") || base=$(git hash-object -t tree /dev/null)
  fi

  echo "== process gate: ${remote_ref#refs/heads/} =="
  if ! bash "$root/.githooks/static-check.sh" "$base" "$local_sha"; then
    if [ "$ref_strict" -eq 1 ]; then
      fail=1
    else
      echo "warning: static-check errors, allowed because this is not main."
    fi
  fi
done

if [ "$fail" -ne 0 ]; then
  echo
  echo "Push to main blocked by static-check (S21-09). Fix the ERROR lines above, or use"
  echo "GATE_ALLOW_REMOVED=<field> for a field deleted on purpose."
  exit 1
fi

if [ "$strict" -eq 0 ]; then
  echo "compile-check: skipped (not pushing to main)"
  exit 0
fi

if [ "${GATE_SKIP_COMPILE:-0}" = "1" ]; then
  echo "compile-check: skipped (GATE_SKIP_COMPILE=1)"
  exit 0
fi

out=$(PROJECT_PATH="$root" bash "$root/.claude/scripts/compile-check.sh" 2>&1)
result=$(printf '%s\n' "$out" | grep -m1 -E 'Result' | sed -E 's/.*Result[^A-Za-z*]*//; s/[*|]//g; s/ +$//')
echo "compile-check: ${result:-no result}"
if printf '%s\n' "$out" | grep -q 'FAILED'; then
  printf '%s\n' "$out" | grep -E '^- `' | head -15
  echo
  echo "Push to main blocked: the project does not compile (TD-048). Fix the errors first."
  exit 1
fi
exit 0
