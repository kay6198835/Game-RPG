{
  "_comment": "Path regex (forward slashes, case-insensitive) -> systems. First match wins for the primary system; every 'risks' rule that matches adds its alsoCheck systems. Systems are the QA-<SYS> prefixes in qa-automation/cases/case-catalog.md.",
  "rules": [
    { "pattern": "^Assets/QA/|^qa-automation/", "systems": ["QA"], "label": "QA automation itself" },
    { "pattern": "^Assets/Script/Character/Player/States/", "systems": ["PLY"], "label": "Player states" },
    { "pattern": "^Assets/Script/Character/Player/CoreComponent/(PlayerInputHandle|PlayerMovement|Interact|Interactor)", "systems": ["PLY"], "label": "Player input / movement / interaction" },
    { "pattern": "^Assets/Script/Character/Player/CoreComponent/(WeaponHolder)", "systems": ["CMB"], "label": "Player weapon holder" },
    { "pattern": "^Assets/Script/Character/Player/CoreComponent/(AbilityHolder)", "systems": ["ABL"], "label": "Player ability holder" },
    { "pattern": "^Assets/Script/Character/Player/CoreComponent/(StatHandler|VitalComponent|NegativeReciver|RegenComponent|ResourceReceiver)", "systems": ["VIT"], "label": "Player stats / vitals / hurtbox" },
    { "pattern": "^Assets/Script/Character/Player/", "systems": ["PLY"], "label": "Player (other)" },
    { "pattern": "^Assets/Script/Character/Entity/", "systems": ["ENT"], "label": "Enemy (Entity)" },
    { "pattern": "^Assets/Script/Character/Base/(AbilityHolderBase)", "systems": ["ABL"], "label": "Shared ability holder" },
    { "pattern": "^Assets/Script/Character/Base/(WeaponHolderBase)", "systems": ["CMB"], "label": "Shared weapon holder" },
    { "pattern": "^Assets/Script/Character/Base/(VitalStatsBase|StatHandlerBase|NegativeReceiverBase|EffectReceiverBase)", "systems": ["VIT"], "label": "Shared vitals / stats / damage" },
    { "pattern": "^Assets/Script/Character/Base/(CharacterData|CharacterBase)", "systems": ["PLY"], "label": "Shared character data" },
    { "pattern": "^Assets/Script/Character/Base/", "systems": ["PLY"], "label": "Shared character base (state machine, core hub)" },
    { "pattern": "^Assets/Script/System/Abilities/", "systems": ["ABL"], "label": "Abilities v2" },
    { "pattern": "^Assets/Script/System/Skill_Ability/", "systems": ["ENT"], "label": "Abilities v1 (enemy weapon path)" },
    { "pattern": "^Assets/Script/Weapons/", "systems": ["CMB"], "label": "Weapons" },
    { "pattern": "^Assets/Script/System/StatSystem/", "systems": ["STAT"], "label": "Stat system" },
    { "pattern": "^Assets/Script/System/PoolableService/", "systems": ["POOL"], "label": "Object pool" },
    { "pattern": "^Assets/Script/System/Pathfinding/", "systems": ["PATH"], "label": "A* pathfinding" },
    { "pattern": "^Assets/Script/System/Enemy/", "systems": ["MAP"], "label": "Enemy spawner / manager" },
    { "pattern": "^Assets/Script/System/Item/", "systems": ["ITEM"], "label": "Items" },
    { "pattern": "^Assets/Script/System/StartGameSystem/", "systems": ["PLY"], "label": "Champion pick" },
    { "pattern": "^Assets/Script/System/PlayerSystem/", "systems": ["PLY"], "label": "PlayerManager" },
    { "pattern": "^Assets/Script/System/LifetimeScope/", "systems": ["PLY"], "label": "VContainer composition root" },
    { "pattern": "^Assets/Script/Map/|^Assets/Script/LevelEdit/|^Assets/Script/Database-SO/|^Assets/Data/Json/Room/", "systems": ["MAP"], "label": "Map / rooms / level data" },
    { "pattern": "^Assets/Script/Manager/EventManager", "systems": ["EVT"], "label": "Event bus" },
    { "pattern": "^Assets/Script/UIFlow/|^Assets/Script/UI/", "systems": ["UI"], "label": "UI" },
    { "pattern": "^Assets/Script/Interface/", "systems": ["PLY"], "label": "Shared interfaces" },
    { "pattern": "^Assets/Script/FastTest/", "systems": ["QA"], "label": "Debug / test harnesses" },
    { "pattern": "^Assets/SO/Skill/", "systems": ["ABL"], "label": "Ability assets" },
    { "pattern": "^Assets/SO/Stat/", "systems": ["STAT"], "label": "Stat assets" },
    { "pattern": "^Assets/SO/Player/", "systems": ["PLY"], "label": "Class data assets" },
    { "pattern": "^Assets/SO/Weapons?/", "systems": ["CMB"], "label": "Weapon assets" },
    { "pattern": "^Assets/SO/Enemy/|^Assets/Prefab/Enemy/", "systems": ["ENT"], "label": "Enemy assets" },
    { "pattern": "^Assets/SO/Database/|^Assets/SO/Dungeon/", "systems": ["MAP"], "label": "Map / room assets" },
    { "pattern": "^Assets/SO/Item/", "systems": ["ITEM"], "label": "Item assets" },
    { "pattern": "^Assets/Prefab/Player/", "systems": ["PLY"], "label": "Player prefab" },
    { "pattern": "^Assets/Prefab/", "systems": ["STATIC"], "label": "Other prefabs" },
    { "pattern": "^Assets/Animation/|^Assets/AnimationController/|^Assets/Sprite/", "systems": ["VISUAL"], "label": "Animation / sprites (manual only)" },
    { "pattern": "^Assets/Scenes/", "systems": ["STATIC"], "label": "Scenes" },
    { "pattern": "^Assets/", "systems": ["STATIC"], "label": "Other assets" },
    { "pattern": "^(production|design|docs|\\.claude)/|\\.md$", "systems": ["DOCS"], "label": "Docs / process (no test impact)" },
    { "pattern": ".*", "systems": ["OTHER"], "label": "Other" }
  ],
  "risks": [
    { "pattern": "^Assets/Script/Character/Base/AbilityHolderBase", "alsoCheck": ["PLY", "ENT", "UI"], "why": "Shared by the player and enemies; the UIFlow hotbar binds to AbilityCooldownStarted" },
    { "pattern": "^Assets/Script/Character/Base/WeaponHolderBase", "alsoCheck": ["PLY", "ENT"], "why": "Shared by the player and enemies; default weapon equip happens in SetCharacterData (BUG-106)" },
    { "pattern": "^Assets/Script/Character/Base/(VitalStatsBase|StatHandlerBase|NegativeReceiverBase|EffectReceiverBase)", "alsoCheck": ["ENT", "ABL", "UI", "STAT"], "why": "One base for player and enemy vitals; abilities pay costs and apply effects through it; the HUD reads CurrentStatsChanged" },
    { "pattern": "^Assets/Script/Character/Base/(CharacterData|CharacterBase)", "alsoCheck": ["ENT", "CMB", "ABL", "STATIC"], "why": "Serialized by every PlayerData / EntityData asset — a rename without [FormerlySerializedAs] empties fields (BUG-105/108/121)" },
    { "pattern": "^Assets/Script/System/StatSystem/", "alsoCheck": ["VIT", "CMB", "ENT", "STATIC"], "why": "Damage formulas, vitals max values and asset serialization all read the stat system" },
    { "pattern": "^Assets/Script/System/Abilities/Core/", "alsoCheck": ["PLY", "ENT", "UI"], "why": "Cast gating and cooldowns drive the player skill state, enemy abilities and the hotbar" },
    { "pattern": "^Assets/Script/System/PoolableService/", "alsoCheck": ["ENT", "CMB", "ABL"], "why": "Enemies, projectiles and ability objects are all pooled and injected on spawn" },
    { "pattern": "^Assets/Script/Manager/EventManager", "alsoCheck": ["MAP", "VIT", "ENT", "UI"], "why": "Room clear, death and HUD binding are all event-driven" },
    { "pattern": "^Assets/Script/Weapons/", "alsoCheck": ["ENT", "STATIC"], "why": "Enemies attack through the same Weapon classes; AttackSO field renames break assets" },
    { "pattern": "^Assets/Script/UIFlow/Core/UIEvents|^Assets/Script/UIFlow/Gameplay/Windows/ConfirnPanel", "alsoCheck": ["PLY"], "why": "The Champion pick flow opens the confirm panel through UIEvents" },
    { "pattern": "^Assets/Script/System/LifetimeScope/|^Assets/Script/System/PlayerSystem/", "alsoCheck": ["VIT", "CMB", "ABL", "ENT"], "why": "Injection of the whole player chain" },
    { "pattern": "^Assets/Script/Map/Room/|^Assets/Script/System/Enemy/", "alsoCheck": ["ENT"], "why": "Room clear depends on ON_ENEMY_DEATH from pooled enemies" },
    { "pattern": "\\.asset$", "alsoCheck": ["STATIC"], "why": "Asset edits: missing script / orphaned key / saved-modifier checks" }
  ],
  "systemToGroup": {
    "PLY": "PLAYER", "CMB": "PLAYER", "ABL": "PLAYER", "UI": "PLAYER",
    "VIT": "VITALS", "ENT": "ENEMY",
    "EVT": "SYSTEMS", "STAT": "SYSTEMS", "POOL": "SYSTEMS", "MAP": "SYSTEMS", "PATH": "SYSTEMS", "ITEM": "SYSTEMS",
    "STATIC": "STATIC"
  }
}
